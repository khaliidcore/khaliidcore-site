# Public site URL (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.khaliidcore.com

# Contact form (https://resend.com). Without these, the form shows a mailto fallback.
RESEND_API_KEY=
# Where messages are delivered (your inbox)
CONTACT_TO_EMAIL=
# Sender. Use onboarding@resend.dev for testing, or an address on a domain you verified in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Paste the token from Google Search Console "HTML tag" verification (content value only). Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
